{
  "name": "sounds-university",
  "version": "0.0.0",
  "private": true,
  "description": "Audio-first university platform",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": "12.16.1"
  },
  "scripts": {
    "dev:web": "pnpm --filter @sounds-university/web dev",
    "dev:api": "pnpm --filter @sounds-university/api start:dev",
    "build": "pnpm --filter @sounds-university/contracts build && pnpm --filter @sounds-university/api-client build && pnpm --filter @sounds-university/api build && pnpm --filter @sounds-university/web build",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
